@model HRMSystem.Models.CompanySetting
@{
    Layout = "_EmployeeDashboardLayout";
    ViewData["Title"] = "Customize Portal";
    ViewData["ActivePage"] = "Admin";
    var notices = ViewBag.Notices as IEnumerable<HRMSystem.Models.Notice>;
    var holidays = ViewBag.Holidays as IEnumerable<HRMSystem.Models.Holiday>;
}

<div class="row">
    <!-- Left Sidebar: Admin Stats & Actions -->
    <div class="col-lg-3 col-md-4 mb-4">
        <!-- Control Box -->
        <div class="bg-white text-center pb-3 shadow-sm border" style="padding: 15px;">
            <div class="profile-img-container mb-3">
                <i class="bi bi-palette-fill display-1 text-primary opacity-25"></i>
            </div>
            <h3 class="profile-name">Customize Portal</h3>
            <div class="profile-role">
                Branding & Assets
            </div>
            <div class="status-box">
                Portal Management
            </div>
        </div>

        <!-- Admin Quick Links -->
        <div class="section-header mt-4">
            <i class="bi bi-gear-fill"></i> Management
        </div>
        <div class="d-grid gap-2">
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-sm btn-outline-primary rounded-pill fw-bold text-start">
                <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>
            <a asp-controller="Employee" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill fw-bold text-start">
                <i class="bi bi-people-fill me-2"></i> Employees
            </a>
            <a asp-controller="Department" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill fw-bold text-start">
                <i class="bi bi-diagram-3-fill me-2"></i> Departments
            </a>
        </div>
    </div>

    <!-- Right Content: Tabs -->
    <div class="col-lg-9 col-md-8">
        <div class="main-content-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-sliders"></i> Portal Customization Settings</span>
        </div>
        <div class="main-content-body shadow-sm bg-white p-4">
            
            <!-- Nav Tabs -->
            <ul class="nav nav-tabs mb-4" id="customTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-bold" id="branding-tab" data-bs-toggle="tab" data-bs-target="#branding" type="button" role="tab"><i class="bi bi-palette me-1"></i> General Branding</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold" id="notices-tab" data-bs-toggle="tab" data-bs-target="#notices" type="button" role="tab"><i class="bi bi-megaphone me-1"></i> Notice Board</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold" id="holidays-tab" data-bs-toggle="tab" data-bs-target="#holidays" type="button" role="tab"><i class="bi bi-calendar-event me-1"></i> Holidays</button>
                </li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content" id="customTabsContent">
                
                <!-- Tab 1: Branding -->
                <div class="tab-pane fade show active" id="branding" role="tabpanel">
                    <form asp-action="UpdateCompanySettings" method="post" enctype="multipart/form-data" class="bg-light p-4 border rounded-3">
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="CompanyName" class="form-label fw-bold small text-uppercase text-muted">Portal Logo Text</label>
                                <input asp-for="CompanyName" class="form-control form-control-lg" placeholder="e.g. Your organization" />
                                <div class="form-text small text-muted">Text shown as logo. Can be left empty if you upload a logo image instead.</div>
                                <div class="form-check mt-2">
                                    <input type="checkbox" class="form-check-input" id="clearLogoText" name="clearLogoText" value="true" />
                                    <label class="form-check-label small text-danger" for="clearLogoText">Remove Logo Text (No Name)</label>
                                </div>
                            </div>
                            
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-bold small text-uppercase text-muted">Portal Logo Image</label>
                                @if (!string.IsNullOrEmpty(Model.LogoImagePath))
                                {
                                    <div class="mb-2 p-2 border bg-white rounded text-center">
                                        <img src="@Model.LogoImagePath" alt="Current Logo" style="max-height: 50px; object-fit: contain;" />
                                    </div>
                                    <div class="form-check mb-2">
                                        <input type="checkbox" class="form-check-input" id="clearLogoImage" name="clearLogoImage" value="true" />
                                        <label class="form-check-label small text-danger" for="clearLogoImage">Delete current Logo Image</label>
                                    </div>
                                }
                                <input type="file" name="logoFile" class="form-control" accept="image/*" />
                                <div class="form-text small text-muted">Upload a custom logo image. Falls back to text if unavailable.</div>
                            </div>
                        </div>
                        
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold"><i class="bi bi-save me-1"></i> Save Customizations</button>
                    </form>
                </div>

                <!-- Tab 2: Notice Board -->
                <div class="tab-pane fade" id="notices" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-uppercase text-muted mb-0">Manage Notice Board Entries</h6>
                        <div class="d-flex gap-2">
                            <a asp-action="ExportNoticesToCsv" class="btn btn-sm btn-outline-success rounded-pill px-3">
                                <i class="bi bi-download me-1"></i> Export CSV
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="collapse" data-bs-target="#importNoticeArea">
                                <i class="bi bi-upload me-1"></i> Import CSV
                            </button>
                            <button type="button" class="btn btn-sm btn-success rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#addNoticeModal">
                                <i class="bi bi-plus-circle me-1"></i> Add Announcement
                            </button>
                        </div>
                    </div>
                    
                    <div class="collapse mb-3" id="importNoticeArea">
                        <form asp-action="ImportNoticesFromCsv" method="post" enctype="multipart/form-data" class="card card-body p-3 border-primary">
                            <label class="form-label fw-bold small">Upload Notices CSV (Headers: Title, Content, Date, IsActive)</label>
                            <div class="input-group">
                                <input type="file" name="csvFile" class="form-control form-control-sm" accept=".csv" required />
                                <button type="submit" class="btn btn-sm btn-success px-4 fw-bold">Upload & Import</button>
                            </div>
                        </form>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Title</th>
                                    <th>Content Summary</th>
                                    <th>Status</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (notices != null && notices.Any())
                                {
                                    foreach (var notice in notices)
                                    {
                                        <tr>
                                            <td>@notice.Date.ToString("dd MMM yyyy")</td>
                                            <td class="fw-bold">@notice.Title</td>
                                            <td class="text-truncate" style="max-width: 250px;">@notice.Content</td>
                                            <td>
                                                <span class="badge @(notice.IsActive ? "bg-success" : "bg-secondary")">@(notice.IsActive ? "Active" : "Hidden")</span>
                                            </td>
                                            <td class="text-center">
                                                <form asp-action="DeleteNotice" method="post" onsubmit="return confirm('Are you sure you want to delete this notice?');" style="display:inline;">
                                                    <input type="hidden" name="id" value="@notice.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">No notice board announcements created yet.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tab 3: Holidays -->
                <div class="tab-pane fade" id="holidays" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-uppercase text-muted mb-0">Manage Holiday Calendar</h6>
                        <div class="d-flex gap-2">
                            <a asp-action="ExportHolidaysToCsv" class="btn btn-sm btn-outline-success rounded-pill px-3">
                                <i class="bi bi-download me-1"></i> Export CSV
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="collapse" data-bs-target="#importHolidayArea">
                                <i class="bi bi-upload me-1"></i> Import CSV
                            </button>
                            <button type="button" class="btn btn-sm btn-success rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#addHolidayModal">
                                <i class="bi bi-plus-circle me-1"></i> Add Holiday
                            </button>
                        </div>
                    </div>

                    <div class="collapse mb-3" id="importHolidayArea">
                        <form asp-action="ImportHolidaysFromCsv" method="post" enctype="multipart/form-data" class="card card-body p-3 border-primary">
                            <label class="form-label fw-bold small">Upload Holidays CSV (Headers: Name, Date, Color)</label>
                            <div class="input-group">
                                <input type="file" name="csvFile" class="form-control form-control-sm" accept=".csv" required />
                                <button type="submit" class="btn btn-sm btn-success px-4 fw-bold">Upload & Import</button>
                            </div>
                        </form>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Holiday Date</th>
                                    <th>Holiday Name</th>
                                    <th>Accent Category</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (holidays != null && holidays.Any())
                                {
                                    foreach (var holiday in holidays)
                                    {
                                        string badgeClass = holiday.Color switch
                                        {
                                            "#fffde7" => "bg-warning text-dark",
                                            "#ffebee" => "bg-danger",
                                            "#f1f8e9" => "bg-success",
                                            _ => "bg-secondary"
                                        };
                                        <tr>
                                            <td>@holiday.Date.ToString("dd MMM yyyy")</td>
                                            <td class="fw-bold">@holiday.Name</td>
                                            <td>
                                                <span class="badge @badgeClass" style="border: 1px solid #ccc;">Office Off</span>
                                            </td>
                                            <td class="text-center">
                                                <form asp-action="DeleteHoliday" method="post" onsubmit="return confirm('Are you sure you want to delete this holiday?');" style="display:inline;">
                                                    <input type="hidden" name="id" value="@holiday.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">No holidays registered in system.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

<!-- Modal: Add Notice -->
<div class="modal fade" id="addNoticeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-0">
            <form asp-action="CreateNotice" method="post">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">New Notice Board Announcement</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Notice Title</label>
                        <input type="text" class="form-control" name="Title" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Notice Content / Description</label>
                        <textarea class="form-control" name="Content" rows="4" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Date</label>
                        <input type="date" class="form-control" name="Date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="isActiveSwitch">
                        <label class="form-check-label" for="isActiveSwitch">Show Immediately</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-0" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary rounded-0">Publish Notice</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Add Holiday -->
<div class="modal fade" id="addHolidayModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-0">
            <form asp-action="CreateHoliday" method="post">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Holiday Event</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Holiday Name</label>
                        <input type="text" class="form-control" name="Name" placeholder="e.g. Office Off" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Date</label>
                        <input type="date" class="form-control" name="Date" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Theme Color Category</label>
                        <select class="form-select" name="Color">
                            <option value="#fffde7">Yellow Category (Warning)</option>
                            <option value="#ffebee">Red Category (Danger)</option>
                            <option value="#f1f8e9">Green Category (Success)</option>
                            <option value="#f5f5f5">Neutral Category (Muted)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-0" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary rounded-0">Add to Calendar</button>
                </div>
            </form>
        </div>
    </div>
</div>
