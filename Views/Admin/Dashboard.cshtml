@{
    Layout = "_EmployeeDashboardLayout";
    ViewData["Title"] = "Admin Dashboard";
    ViewData["ActivePage"] = "Admin";
}


<div class="row">
    <!-- Left Sidebar: Admin Stats & Actions -->
    <div class="col-lg-3 col-md-4 mb-4">
        <!-- Profile Box -->
        <div class="bg-white text-center pb-3 shadow-sm border" style="padding: 15px;">
            <div class="profile-img-container mb-3">
                <i class="bi bi-shield-lock-fill display-1 text-primary opacity-25"></i>
            </div>
            <h3 class="profile-name">System Admin</h3>
            <div class="profile-role">
                Administrator
            </div>
            <div class="status-box">
                Control Center
            </div>
        </div>

        <!-- Admin Quick Links -->
        <div class="section-header mt-4">
            <i class="bi bi-gear-fill"></i> Management
        </div>
        <div class="d-grid gap-2">
            <a asp-controller="Employee" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill fw-bold text-start">
                <i class="bi bi-people-fill me-2"></i> Employees
            </a>
            <a asp-controller="Department" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill fw-bold text-start">
                <i class="bi bi-diagram-3-fill me-2"></i> Departments
            </a>
            <a asp-controller="Designation" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill fw-bold text-start">
                <i class="bi bi-briefcase-fill me-2"></i> Designations
            </a>
            <a asp-controller="Leave" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill fw-bold text-start">
                <i class="bi bi-envelope-paper-fill me-2"></i> Leave Requests
            </a>
            <a asp-controller="LeaveBalance" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill fw-bold text-start">
                <i class="bi bi-wallet2 me-2"></i> Leave Balances
            </a>
            <a asp-controller="Admin" asp-action="TotalLeaves" class="btn btn-sm btn-outline-primary rounded-pill fw-bold text-start">
                <i class="bi bi-grid-3x3-gap-fill me-2"></i> Total Leaves
            </a>
            <a asp-controller="LeaveType" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill fw-bold text-start">
                <i class="bi bi-gear-wide-connected me-2"></i> Leave Types
            </a>
            <a asp-controller="Admin" asp-action="ProfileRequests" class="btn btn-sm btn-outline-primary rounded-pill fw-bold text-start">
                <i class="bi bi-person-fill-lock me-2"></i> Profile Approvals
            </a>
            <a asp-controller="Payroll" asp-action="Generate" class="btn btn-sm btn-outline-primary rounded-pill fw-bold text-start">
                <i class="bi bi-cash-stack me-2"></i> Run Payroll
            </a>
        </div>
    </div>

    <!-- Right Content: Stats Overview -->
    <div class="col-lg-9 col-md-8">
        <div class="main-content-header">
            <i class="bi bi-speedometer2"></i> Admin Dashboard Overview
        </div>
        <div class="main-content-body shadow-sm">
            <div class="row g-4">
                <!-- Employees Card -->
                <div class="col-md-3">
                    <div class="card bg-primary text-white shadow-sm border-0 rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-white-50 fw-bold text-uppercase small">Employees</div>
                                    <div class="fs-2 fw-bold">@ViewBag.TotalEmployees</div>
                                </div>
                                <i class="bi bi-people fs-1 opacity-50"></i>
                            </div>
                        </div>
                        <a asp-controller="Employee" asp-action="Index" class="card-footer d-flex align-items-center justify-content-between bg-primary bg-opacity-75 border-0 text-white text-decoration-none py-2 px-3">
                            <span class="small">View All</span>
                            <i class="bi bi-chevron-right small"></i>
                        </a>
                    </div>
                </div>

                <!-- Departments Card -->
                <div class="col-md-3">
                    <div class="card bg-success text-white shadow-sm border-0 rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-white-50 fw-bold text-uppercase small">Departments</div>
                                    <div class="fs-2 fw-bold">@ViewBag.TotalDepartments</div>
                                </div>
                                <i class="bi bi-diagram-3 fs-1 opacity-50"></i>
                            </div>
                        </div>
                        <a asp-controller="Department" asp-action="Index" class="card-footer d-flex align-items-center justify-content-between bg-success bg-opacity-75 border-0 text-white text-decoration-none py-2 px-3">
                            <span class="small">View All</span>
                            <i class="bi bi-chevron-right small"></i>
                        </a>
                    </div>
                </div>

                <!-- Pending Leaves Card -->
                <div class="col-md-3">
                    <div class="card bg-warning text-dark shadow-sm border-0 rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-dark-50 fw-bold text-uppercase small">Pending Leaves</div>
                                    <div class="fs-2 fw-bold">@ViewBag.PendingLeaves</div>
                                </div>
                                <i class="bi bi-envelope-exclamation fs-1 opacity-50"></i>
                            </div>
                        </div>
                        <a asp-controller="Leave" asp-action="Index" class="card-footer d-flex align-items-center justify-content-between bg-warning border-top border-dark border-opacity-10 text-dark text-decoration-none py-2 px-3 fw-bold">
                            <span class="small">Review Requests</span>
                            <i class="bi bi-chevron-right small"></i>
                        </a>
                    </div>
                </div>

                <!-- Pending Profile Changes Card -->
                <div class="col-md-3">
                    <div class="card bg-info text-white shadow-sm border-0 rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-white-50 fw-bold text-uppercase small">Profile Updates</div>
                                    <div class="fs-2 fw-bold">@ViewBag.PendingProfileRequests</div>
                                </div>
                                <i class="bi bi-person-fill-lock fs-1 opacity-50"></i>
                            </div>
                        </div>
                        <a asp-controller="Admin" asp-action="ProfileRequests" class="card-footer d-flex align-items-center justify-content-between bg-info bg-opacity-75 border-0 text-white text-decoration-none py-2 px-3 fw-bold">
                            <span class="small">Review Updates</span>
                            <i class="bi bi-chevron-right small"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-12">
                    <div class="card shadow-sm border-0 rounded-4">
                        <div class="card-header bg-white border-bottom fw-bold py-3">
                            <i class="bi bi-stars text-primary me-2"></i> Quick Operations
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <a asp-controller="Employee" asp-action="Create" class="btn btn-outline-primary w-100 p-3 rounded-3 text-start h-100">
                                        <i class="bi bi-person-plus fs-4 me-2 align-middle"></i> 
                                        <div class="mt-2 fw-bold">Register Employee</div>
                                    </a>
                                </div>
                                <div class="col-md-3">
                                    <a asp-controller="LeaveBalance" asp-action="Index" class="btn btn-outline-info w-100 p-3 rounded-3 text-start h-100">
                                        <i class="bi bi-wallet2 fs-4 me-2 align-middle"></i> 
                                        <div class="mt-2 fw-bold">Leave Balances</div>
                                    </a>
                                </div>
                                <div class="col-md-3">
                                    <a asp-controller="Designation" asp-action="Index" class="btn btn-outline-warning w-100 p-3 rounded-3 text-start h-100">
                                        <i class="bi bi-briefcase fs-4 me-2 align-middle"></i> 
                                        <div class="mt-2 fw-bold">Manage Designations</div>
                                    </a>
                                </div>
                                <div class="col-md-3">
                                    <a asp-controller="Payroll" asp-action="Generate" class="btn btn-outline-success w-100 p-3 rounded-3 text-start h-100">
                                        <i class="bi bi-cash-stack fs-4 me-2 align-middle"></i> 
                                        <div class="mt-2 fw-bold">Generate Payroll</div>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

