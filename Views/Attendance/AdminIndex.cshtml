@model IEnumerable<HRMSystem.Models.Attendance>
@{
    Layout = "_EmployeeDashboardLayout";
    ViewData["Title"] = "Attendance Logs";
    ViewData["ActivePage"] = "Admin";
    var departments = ViewBag.Departments as IEnumerable<HRMSystem.Models.Department>;
    var startDate = ViewBag.StartDate as DateTime?;
    var endDate = ViewBag.EndDate as DateTime?;
    var currentDeptId = ViewBag.DepartmentId as int?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-shield-check me-2 text-primary"></i>Employee Attendance Logs</h3>
        <p class="text-muted small mb-0">Monitor employee Clock In, Clock Out, work duration, and location verification status.</p>
    </div>
    <div>
        <a asp-action="ManageLocations" class="btn btn-outline-primary rounded-pill px-3 btn-sm me-2">
            <i class="bi bi-geo-alt-fill me-1"></i>Manage Office Locations
        </a>
        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-secondary rounded-pill px-3 btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Admin Dashboard
        </a>
    </div>
</div>

<!-- Filters -->
<div class="card shadow-sm border-0 mb-4 rounded-3">
    <div class="card-body p-3">
        <form method="get" asp-action="AdminIndex" class="row g-2 align-items-center">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Start Date</label>
                <input type="date" name="startDate" value="@(startDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">End Date</label>
                <input type="date" name="endDate" value="@(endDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Department</label>
                <select name="departmentId" class="form-select form-select-sm">
                    <option value="">-- All Departments --</option>
                    @if (departments != null)
                    {
                        foreach (var dept in departments)
                        {
                            <option value="@dept.Id" selected="@(currentDeptId == dept.Id ? "selected" : null)">@dept.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary btn-sm w-100 rounded-pill mt-3">
                    <i class="bi bi-funnel me-1"></i>Filter Logs
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Employee</th>
                            <th>Department</th>
                            <th>Date</th>
                            <th>Clock In</th>
                            <th>Clock Out</th>
                            <th class="text-center">Selfie Proof</th>
                            <th>Work Duration</th>
                            <th>GPS Verified</th>
                            <th>Punch Location</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@item.Employee?.FullName</div>
                                    <div class="text-muted small">@item.Employee?.EmployeeCode</div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@(item.Employee?.Department?.Name ?? "--")</span></td>
                                <td class="fw-bold">@item.Date.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (item.ClockInTime.HasValue)
                                    {
                                        <div class="d-inline-flex align-items-center gap-1">
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="bi bi-box-arrow-in-right me-1"></i>@item.ClockInTime.Value.ToString("hh:mm tt")
                                            </span>
                                            @if (!string.IsNullOrEmpty(item.ClockInPhotoPath))
                                            {
                                                <a href="javascript:void(0);" onclick="showSelfieModal('@item.ClockInPhotoPath', '@(item.Employee?.FullName ?? "Employee") - Clock In Selfie', '@item.ClockInTime.Value.ToString("hh:mm tt, dd MMM yyyy")', '@(item.ClockInLocationName ?? "Verified Location")')" title="View Clock In Selfie" class="text-decoration-none">
                                                    <img src="@item.ClockInPhotoPath" class="rounded-circle border border-2 border-success shadow-sm" style="width: 24px; height: 24px; object-fit: cover;" alt="Selfie" onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=@(Uri.EscapeDataString(item.Employee?.FullName ?? "Emp"))&background=e8f5e9&color=2e7d32';" />
                                                </a>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--:--</span>
                                    }
                                </td>
                                <td>
                                    @if (item.ClockOutTime.HasValue)
                                    {
                                        <div class="d-inline-flex align-items-center gap-1">
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                <i class="bi bi-box-arrow-left me-1"></i>@item.ClockOutTime.Value.ToString("hh:mm tt")
                                            </span>
                                            @if (!string.IsNullOrEmpty(item.ClockOutPhotoPath))
                                            {
                                                <a href="javascript:void(0);" onclick="showSelfieModal('@item.ClockOutPhotoPath', '@(item.Employee?.FullName ?? "Employee") - Clock Out Selfie', '@item.ClockOutTime.Value.ToString("hh:mm tt, dd MMM yyyy")', '@(item.ClockOutLocationName ?? "Verified Location")')" title="View Clock Out Selfie" class="text-decoration-none">
                                                    <img src="@item.ClockOutPhotoPath" class="rounded-circle border border-2 border-danger shadow-sm" style="width: 24px; height: 24px; object-fit: cover;" alt="Selfie" onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=@(Uri.EscapeDataString(item.Employee?.FullName ?? "Emp"))&background=ffebee&color=c62828';" />
                                                </a>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--:--</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(item.ClockInPhotoPath))
                                        {
                                            <div class="position-relative d-inline-block" role="button" onclick="showSelfieModal('@item.ClockInPhotoPath', '@(item.Employee?.FullName ?? "Employee") - Clock In Selfie', '@(item.ClockInTime.HasValue ? item.ClockInTime.Value.ToString("hh:mm tt, dd MMM yyyy") : "")', '@(item.ClockInLocationName ?? "Verified Location")')" title="Click to view Clock In Selfie">
                                                <img src="@item.ClockInPhotoPath" class="rounded-circle border border-2 border-success shadow-sm" style="width: 34px; height: 34px; object-fit: cover; cursor: pointer;" alt="In" onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=@(Uri.EscapeDataString(item.Employee?.FullName ?? "Emp"))&background=e8f5e9&color=2e7d32';" />
                                                <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-success p-1" style="font-size: 0.55rem; line-height: 1;" title="Clock-In Photo">IN</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(item.ClockOutPhotoPath))
                                        {
                                            <div class="position-relative d-inline-block" role="button" onclick="showSelfieModal('@item.ClockOutPhotoPath', '@(item.Employee?.FullName ?? "Employee") - Clock Out Selfie', '@(item.ClockOutTime.HasValue ? item.ClockOutTime.Value.ToString("hh:mm tt, dd MMM yyyy") : "")', '@(item.ClockOutLocationName ?? "Verified Location")')" title="Click to view Clock Out Selfie">
                                                <img src="@item.ClockOutPhotoPath" class="rounded-circle border border-2 border-danger shadow-sm" style="width: 34px; height: 34px; object-fit: cover; cursor: pointer;" alt="Out" onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=@(Uri.EscapeDataString(item.Employee?.FullName ?? "Emp"))&background=ffebee&color=c62828';" />
                                                <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-danger p-1" style="font-size: 0.55rem; line-height: 1;" title="Clock-Out Photo">OUT</span>
                                            </div>
                                        }
                                        @if (string.IsNullOrEmpty(item.ClockInPhotoPath) && string.IsNullOrEmpty(item.ClockOutPhotoPath))
                                        {
                                            <span class="badge bg-light text-muted border px-2 py-1" style="font-size: 0.72rem;"><i class="bi bi-camera-slash me-1"></i>None</span>
                                        }
                                    </div>
                                </td>
                                <td class="fw-bold text-primary">@item.DisplayWorkDuration</td>
                                <td>
                                    @if (item.IsLocationVerified)
                                    {
                                        <span class="badge bg-success px-2 py-1"><i class="bi bi-geo-alt-fill me-1"></i>Verified GPS</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-2 py-1"><i class="bi bi-geo-alt me-1"></i>Standard</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block" style="max-width: 150px;" title="@item.ClockInLocationName">
                                        <i class="bi bi-building text-muted me-1"></i>@(item.ClockInLocationName ?? "Main Office")
                                    </span>
                                </td>
                                <td>
                                    @if (item.Status == "Completed")
                                    {
                                        <span class="badge bg-primary px-3 rounded-pill"><i class="bi bi-check-all me-1"></i>Completed</span>
                                    }
                                    else if (item.Status == "Clocked In")
                                    {
                                        <span class="badge bg-warning text-dark px-3 rounded-pill"><i class="bi bi-play-circle me-1"></i>In Progress</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 rounded-pill">@item.Status</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-calendar-x fs-1 opacity-25"></i>
                <p class="mt-2 mb-0">No attendance logs found matching the filter criteria.</p>
            </div>
        }
    </div>
</div>

<!-- Selfie Preview Lightbox Modal -->
<div class="modal fade" id="selfiePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white py-2 px-3">
                <h6 class="modal-title fw-bold" id="selfieModalTitle"><i class="bi bi-person-bounding-box me-2"></i>Attendance Selfie</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0 text-center bg-black position-relative" style="min-height: 280px; display: flex; align-items: center; justify-content: center;">
                <img id="selfieModalImg" src="" class="img-fluid w-100" style="max-height: 420px; object-fit: contain;" alt="Selfie Verification" onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=Selfie+Proof&background=222&color=fff';" />
            </div>
            <div class="modal-footer bg-light py-2 px-3 justify-content-between">
                <div class="text-start">
                    <div id="selfieModalTime" class="fw-bold text-dark small"></div>
                    <div id="selfieModalLoc" class="text-muted" style="font-size: 0.75rem;"></div>
                </div>
                <div class="d-flex gap-2">
                    <a id="selfieModalOpenBtn" href="#" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-2" title="Open full resolution in new tab">
                        <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showSelfieModal(photoUrl, title, timeStr, locStr) {
            $('#selfieModalTitle').html('<i class="bi bi-person-bounding-box me-2"></i>' + (title || 'Attendance Selfie'));
            $('#selfieModalImg').attr('src', photoUrl);
            $('#selfieModalOpenBtn').attr('href', photoUrl);
            $('#selfieModalTime').text(timeStr || '');
            $('#selfieModalLoc').text(locStr ? 'Location: ' + locStr : '');
            var modal = new bootstrap.Modal(document.getElementById('selfiePreviewModal'));
            modal.show();
        }
    </script>
}
