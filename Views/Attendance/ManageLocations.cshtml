@model IEnumerable<HRMSystem.Models.OfficeLocation>
@{
    Layout = "_EmployeeDashboardLayout";
    ViewData["Title"] = "Office Locations";
    ViewData["ActivePage"] = "Admin";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-geo-alt-fill me-2 text-danger"></i>Manage Office Geofence Locations</h3>
        <p class="text-muted small mb-0">Configure permitted office location coordinates and allowed radius boundaries for Clock In & Clock Out enforcement.</p>
    </div>
    <div>
        <button type="button" class="btn btn-primary rounded-pill px-3 btn-sm me-2" data-bs-toggle="modal" data-bs-target="#locationModal" onclick="openCreateModal()">
            <i class="bi bi-plus-lg me-1"></i>Add Office Location
        </button>
        <a asp-action="AdminIndex" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Attendance Logs
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Location Name</th>
                            <th>Address</th>
                            <th>Latitude</th>
                            <th>Longitude</th>
                            <th>Allowed Radius</th>
                            <th>Geofence Enforced</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loc in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">
                                    <i class="bi bi-building text-primary me-2"></i>@loc.Name
                                </td>
                                <td class="text-muted">@(loc.Address ?? "--")</td>
                                <td><code>@loc.Latitude.ToString("F6")</code></td>
                                <td><code>@loc.Longitude.ToString("F6")</code></td>
                                <td>
                                    <span class="badge bg-light text-dark border fw-bold px-2 py-1">
                                        <i class="bi bi-bullseye text-danger me-1"></i>@loc.AllowedRadiusMeters m
                                    </span>
                                </td>
                                <td>
                                    @if (loc.IsEnforced)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-shield-check me-1"></i>Enforced</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-shield-slash me-1"></i>Disabled</span>
                                    }
                                </td>
                                <td>
                                    @if (loc.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-2">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-sm btn-outline-primary me-1 rounded-pill" onclick='openEditModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(loc)))'>
                                        <i class="bi bi-pencil-fill me-1"></i>Edit
                                    </button>
                                    <form asp-action="DeleteLocation" asp-route-id="@loc.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this office location?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-geo-alt fs-1 opacity-25"></i>
                <p class="mt-2 mb-0">No office locations configured.</p>
            </div>
        }
    </div>
</div>

<!-- Add/Edit Location Modal -->
<div class="modal fade" id="locationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="SaveLocation" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="locId" name="Id" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="modalTitle"><i class="bi bi-geo-alt-fill text-danger me-2"></i>Add Office Location</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Location Name</label>
                        <input type="text" id="locName" name="Name" class="form-control" placeholder="e.g. Main HQ Office" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Address / Description</label>
                        <input type="text" id="locAddress" name="Address" class="form-control" placeholder="e.g. 100 Corporate Tech Park" />
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-bold small mb-0">GPS Coordinates</label>
                        <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2 py-0" style="font-size:0.75rem;" onclick="fillCurrentCoordinates()">
                            <i class="bi bi-crosshair me-1"></i>Use My Current Location
                        </button>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small text-muted">Latitude</label>
                            <input type="number" step="any" id="locLatitude" name="Latitude" class="form-control" placeholder="e.g. 23.0225" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted">Longitude</label>
                            <input type="number" step="any" id="locLongitude" name="Longitude" class="form-control" placeholder="e.g. 72.5714" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small">Allowed Geofence Radius (Meters)</label>
                        <input type="number" step="1" id="locRadius" name="AllowedRadiusMeters" class="form-control" value="300" required />
                        <div class="form-text small">Employees must be within this distance (in meters) to Clock In or Clock Out.</div>
                    </div>

                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="locIsEnforced" name="IsEnforced" value="true" checked />
                        <label class="form-check-label fw-bold small" for="locIsEnforced">Strictly Enforce Geofence Validation</label>
                    </div>

                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="locIsActive" name="IsActive" value="true" checked />
                        <label class="form-check-label fw-bold small" for="locIsActive">Active Location</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Save Location</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openCreateModal() {
            $('#modalTitle').html('<i class="bi bi-geo-alt-fill text-danger me-2"></i>Add Office Location');
            $('#locId').val(0);
            $('#locName').val('');
            $('#locAddress').val('');
            $('#locLatitude').val('');
            $('#locLongitude').val('');
            $('#locRadius').val(300);
            $('#locIsEnforced').prop('checked', true);
            $('#locIsActive').prop('checked', true);
        }

        function openEditModal(loc) {
            $('#modalTitle').html('<i class="bi bi-pencil-square text-primary me-2"></i>Edit Office Location');
            $('#locId').val(loc.Id);
            $('#locName').val(loc.Name);
            $('#locAddress').val(loc.Address);
            $('#locLatitude').val(loc.Latitude);
            $('#locLongitude').val(loc.Longitude);
            $('#locRadius').val(loc.AllowedRadiusMeters);
            $('#locIsEnforced').prop('checked', loc.IsEnforced);
            $('#locIsActive').prop('checked', loc.IsActive);
            $('#locationModal').modal('show');
        }

        function fillCurrentCoordinates() {
            if (!navigator.geolocation) {
                alert('Geolocation is not supported by your browser.');
                return;
            }
            navigator.geolocation.getCurrentPosition(
                function(pos) {
                    $('#locLatitude').val(pos.coords.latitude);
                    $('#locLongitude').val(pos.coords.longitude);
                },
                function(err) {
                    alert('Could not retrieve browser location. Please allow location permissions.');
                },
                { enableHighAccuracy: true }
            );
        }
    </script>
}
