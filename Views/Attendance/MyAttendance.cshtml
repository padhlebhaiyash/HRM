@model IEnumerable<HRMSystem.Models.Attendance>
@{
    Layout = "_EmployeeDashboardLayout";
    ViewData["Title"] = "My Attendance History";
    ViewData["ActivePage"] = "Attendance";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-clock-history me-2 text-primary"></i>My Attendance Logs</h3>
        <p class="text-muted small mb-0">Track your daily clock in, clock out, location verification, and total work hours.</p>
    </div>
    <a asp-controller="EmployeeSelf" asp-action="Dashboard" class="btn btn-outline-primary rounded-pill px-3 btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
    </a>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-secondary"><i class="bi bi-list-check me-2"></i>Attendance Log Records</h6>
        <span class="badge bg-light text-dark border">Showing last 60 records</span>
    </div>
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Date</th>
                            <th>Clock In</th>
                            <th>Clock Out</th>
                            <th>Work Duration</th>
                            <th>Location Verified</th>
                            <th>Clock-in Location</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@item.Date.ToString("ddd, dd MMM yyyy")</td>
                                <td>
                                    @if (item.ClockInTime.HasValue)
                                    {
                                        <div class="d-inline-flex align-items-center gap-1">
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="bi bi-box-arrow-in-right me-1"></i>@item.ClockInTime.Value.ToString("hh:mm tt")
                                            </span>
                                            @if (!string.IsNullOrEmpty(item.ClockInPhotoPath))
                                            {
                                                <a href="javascript:void(0);" onclick="showSelfieModal('@item.ClockInPhotoPath', 'My Clock In Selfie', '@item.ClockInTime.Value.ToString("hh:mm tt, dd MMM yyyy")', '@(item.ClockInLocationName ?? "Verified Location")')" title="View Clock In Selfie" class="text-decoration-none">
                                                    <img src="@item.ClockInPhotoPath" class="rounded-circle border border-2 border-success shadow-sm" style="width: 26px; height: 26px; object-fit: cover;" alt="Selfie" />
                                                </a>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--:--</span>
                                    }
                                </td>
                                <td>
                                    @if (item.ClockOutTime.HasValue)
                                    {
                                        <div class="d-inline-flex align-items-center gap-1">
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                <i class="bi bi-box-arrow-left me-1"></i>@item.ClockOutTime.Value.ToString("hh:mm tt")
                                            </span>
                                            @if (!string.IsNullOrEmpty(item.ClockOutPhotoPath))
                                            {
                                                <a href="javascript:void(0);" onclick="showSelfieModal('@item.ClockOutPhotoPath', 'My Clock Out Selfie', '@item.ClockOutTime.Value.ToString("hh:mm tt, dd MMM yyyy")', '@(item.ClockOutLocationName ?? "Verified Location")')" title="View Clock Out Selfie" class="text-decoration-none">
                                                    <img src="@item.ClockOutPhotoPath" class="rounded-circle border border-2 border-danger shadow-sm" style="width: 26px; height: 26px; object-fit: cover;" alt="Selfie" />
                                                </a>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--:--</span>
                                    }
                                </td>
                                <td class="fw-bold text-primary">@item.DisplayWorkDuration</td>
                                <td>
                                    @if (item.IsLocationVerified)
                                    {
                                        <span class="badge bg-success px-2 py-1"><i class="bi bi-geo-alt-fill me-1"></i>Verified GPS</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-2 py-1"><i class="bi bi-geo-alt me-1"></i>Standard</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block" style="max-width: 180px;" title="@item.ClockInLocationName">
                                        <i class="bi bi-building text-muted me-1"></i>@(item.ClockInLocationName ?? "Main Office")
                                    </span>
                                </td>
                                <td>
                                    @if (item.Status == "Completed")
                                    {
                                        <span class="badge bg-primary px-3 rounded-pill"><i class="bi bi-check-all me-1"></i>Completed</span>
                                    }
                                    else if (item.Status == "Clocked In")
                                    {
                                        <span class="badge bg-warning text-dark px-3 rounded-pill"><i class="bi bi-play-circle me-1"></i>In Progress</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 rounded-pill">@item.Status</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-clock-history fs-1 opacity-25"></i>
                <p class="mt-2 mb-0">No attendance logs found.</p>
            </div>
        }
    </div>
</div>

<!-- Selfie Preview Lightbox Modal -->
<div class="modal fade" id="selfiePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 380px;">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white py-2 px-3">
                <h6 class="modal-title fw-bold" id="selfieModalTitle"><i class="bi bi-person-bounding-box me-2"></i>Attendance Selfie</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0 text-center bg-black position-relative">
                <img id="selfieModalImg" src="" class="img-fluid w-100" style="max-height: 380px; object-fit: cover;" alt="Selfie Verification" />
            </div>
            <div class="modal-footer bg-light py-2 px-3 justify-content-between">
                <div class="text-start">
                    <div id="selfieModalTime" class="fw-bold text-dark small"></div>
                    <div id="selfieModalLoc" class="text-muted" style="font-size: 0.75rem;"></div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showSelfieModal(photoUrl, title, timeStr, locStr) {
            $('#selfieModalTitle').html('<i class="bi bi-person-bounding-box me-2"></i>' + (title || 'Attendance Selfie'));
            $('#selfieModalImg').attr('src', photoUrl);
            $('#selfieModalTime').text(timeStr || '');
            $('#selfieModalLoc').text(locStr ? 'Location: ' + locStr : '');
            var modal = new bootstrap.Modal(document.getElementById('selfiePreviewModal'));
            modal.show();
        }
    </script>
}
