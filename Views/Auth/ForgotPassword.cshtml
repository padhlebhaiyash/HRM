@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Forgot Password";
}

<div class="login-card p-5">
    <div class="text-center mb-4">
        <i class="bi bi-envelope-at display-4 text-info"></i>
        <h4 class="mt-3 fw-bold">Forgot Password?</h4>
        <p class="text-muted small">Enter your registered email address and we'll reset your password for you.</p>
    </div>

    <form asp-action="ForgotPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

        <div class="form-floating mb-4">
            <input type="email" class="form-control rounded-3" id="email" name="email"
                   placeholder="Email Address" required autofocus>
            <label for="email"><i class="bi bi-envelope me-1"></i> Email Address</label>
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-login mb-2">
                <i class="bi bi-arrow-clockwise me-1"></i> Reset Password
            </button>
            <a asp-action="Login" class="btn btn-outline-secondary rounded-0 btn-block py-2">
                <i class="bi bi-arrow-left me-1"></i> Back to Login
            </a>
        </div>
    </form>
</div>
