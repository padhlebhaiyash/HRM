@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Check Your Email";
}

<div class="login-card p-4 p-sm-5">
    <div class="text-center mb-4">
        <div class="display-3 text-primary mb-2">
            <i class="bi bi-envelope-check-fill"></i>
        </div>
        <h4 class="fw-bold">Check Your Email</h4>
    </div>

    <div class="alert alert-info border-0 rounded-3 p-3 mb-4 text-center">
        <p class="mb-0 small">
            If an account exists for <strong>@ViewBag.Email</strong>, we have sent a password reset link to it. <br><br>
            Please check your inbox (and spam folder) and click the link to reset your password.
        </p>
    </div>

    @if (TempData["EmailWarning"] != null)
    {
        <div class="alert alert-warning border-0 rounded-3 p-3 mb-4 text-center small">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["EmailWarning"]
        </div>
    }

    <div class="d-grid gap-2 mt-4">
        <a asp-action="Login" class="btn btn-outline-primary rounded-2 py-2 fw-bold">
            <i class="bi bi-arrow-left me-1"></i> Return to Login
        </a>
    </div>
</div>
