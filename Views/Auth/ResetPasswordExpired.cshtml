@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Link Expired";
}

<div class="login-card p-5 text-center">
    <div class="display-3 text-danger mb-3">
        <i class="bi bi-exclamation-triangle-fill"></i>
    </div>
    <h4 class="fw-bold">Link Expired or Invalid</h4>
    
    <p class="text-muted mt-3 mb-4">
        This password reset link is invalid, has already been used, or has expired. 
        Tokens expire after 30 minutes for security reasons.
    </p>

    <div class="d-grid gap-3">
        <a asp-action="ForgotPassword" class="btn btn-login">
            Request New Link
        </a>
        <a asp-action="Login" class="btn btn-outline-secondary rounded-0 py-2">
            Back to Login
        </a>
    </div>
</div>
