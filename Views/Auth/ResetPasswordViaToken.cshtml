@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Reset Password";
}

<div class="login-card p-4 p-sm-5" style="border-top: 4px solid #198754;">
    <div class="text-center mb-4">
        <div class="mb-2">
            <i class="bi bi-key-fill display-4 text-success"></i>
        </div>
        <h4 class="mt-2 fw-bold text-dark">Create New Password</h4>
        <p class="text-muted small mb-0">Enter a new secure password for <strong>@ViewBag.Username</strong>.</p>
    </div>

    <form asp-action="ResetPasswordViaToken" method="post">
        <input type="hidden" name="token" value="@ViewBag.Token" />
        
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

        <div class="form-floating mb-1 position-relative">
            <input type="password" class="form-control rounded-3 pe-5" id="newPassword" name="newPassword" 
                   placeholder="New Password" required minlength="6" autofocus>
            <label for="newPassword"><i class="bi bi-lock me-1"></i>New Password</label>
            <button type="button" class="btn-floating-password-toggle" onclick="togglePasswordVisibility('newPassword', this)" title="Show/Hide Password" aria-label="Show password">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <div class="form-text text-muted small mb-3">
            <i class="bi bi-info-circle me-1"></i>Password must be at least 6 characters.
        </div>

        <div class="form-floating mb-4 position-relative">
            <input type="password" class="form-control rounded-3 pe-5" id="confirmPassword" name="confirmPassword" 
                   placeholder="Confirm Password" required minlength="6">
            <label for="confirmPassword"><i class="bi bi-check2-circle me-1"></i>Confirm Password</label>
            <button type="button" class="btn-floating-password-toggle" onclick="togglePasswordVisibility('confirmPassword', this)" title="Show/Hide Password" aria-label="Show password">
                <i class="bi bi-eye"></i>
            </button>
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-success btn-lg rounded-2 fw-bold shadow-sm py-2">
                <i class="bi bi-check-lg me-1"></i>Reset Password
            </button>
            <a asp-action="Login" class="btn btn-outline-secondary rounded-2 py-2">
                Back to Login
            </a>
        </div>
    </form>
</div>
