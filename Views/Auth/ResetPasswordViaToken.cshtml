@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Reset Password";
}

<div class="login-card p-4 p-sm-5">
    <div class="text-center mb-4">
        <i class="bi bi-key-fill display-4 text-success"></i>
        <h4 class="mt-3 fw-bold">Create New Password</h4>
        <p class="text-muted small">Enter a new secure password for <strong>@ViewBag.Username</strong>.</p>
    </div>

    <form asp-action="ResetPasswordViaToken" method="post">
        <input type="hidden" name="token" value="@ViewBag.Token" />
        
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

        <div class="form-floating mb-3">
            <input type="password" class="form-control rounded-3" id="newPassword" name="newPassword" 
                   placeholder="New Password" required minlength="6" autofocus>
            <label for="newPassword">New Password</label>
        </div>

        <div class="form-floating mb-4">
            <input type="password" class="form-control rounded-3" id="confirmPassword" name="confirmPassword" 
                   placeholder="Confirm Password" required minlength="6">
            <label for="confirmPassword">Confirm Password</label>
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-login">
                Reset Password
            </button>
        </div>
    </form>
</div>
