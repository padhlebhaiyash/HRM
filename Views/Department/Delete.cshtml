@model HRMSystem.Models.Department
@{
    ViewData["Title"] = "Delete Department";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow border-0 rounded-4 mt-5">
            <div class="card-header bg-danger text-white p-4 rounded-top-4">
                <h4 class="m-0 fw-bold"><i class="bi bi-exclamation-triangle me-2"></i> Delete Department</h4>
            </div>
            <div class="card-body p-4">
                <p class="lead">Are you sure you want to delete this department?</p>
                <hr />
                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Department Name</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Name</dd>

                    <dt class="col-sm-4 text-muted">Description</dt>
                    <dd class="col-sm-8">@Model.Description</dd>

                    <dt class="col-sm-4 text-muted">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success rounded-pill px-3">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger rounded-pill px-3">Inactive</span>
                        }
                    </dd>
                </dl>

                <div class="alert alert-warning border-0 shadow-sm mb-4">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    Deleting a department is permanent. Please ensure no employees are currently assigned to it.
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-trash me-1"></i> Confirm Delete
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
