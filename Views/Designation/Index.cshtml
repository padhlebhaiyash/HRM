@model IEnumerable<HRMSystem.Models.Designation>
@{
    Layout = "_EmployeeDashboardLayout";
    ViewData["Title"] = "Manage Designations";
    ViewData["ActivePage"] = "Admin";
}

<div class="row">
    <!-- Left Sidebar: Actions -->
    <div class="col-lg-3 col-md-4 mb-4">
        <div class="bg-white text-center pb-3 shadow-sm border" style="padding: 15px;">
            <div class="profile-img-container mb-3">
                <i class="bi bi-diagram-3 display-1 text-primary opacity-25"></i>
            </div>
            <h3 class="profile-name">Designations</h3>
            <div class="profile-role">
                Hierarchy Control
            </div>
            <div class="status-box">
                Configure Ranks
            </div>
        </div>

        <div class="d-grid gap-2 mt-4">
            <button type="button" class="btn btn-sm btn-success rounded-pill fw-bold" data-bs-toggle="modal" data-bs-target="#createDesignationModal">
                <i class="bi bi-plus-circle me-1"></i> Add Designation
            </button>

            <a asp-action="ExportToCsv" class="btn btn-sm btn-outline-success rounded-pill fw-bold">
                <i class="bi bi-download me-1"></i> Export to CSV
            </a>
            
            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill fw-bold" data-bs-toggle="collapse" data-bs-target="#importCsvArea">
                <i class="bi bi-upload me-1"></i> Import from CSV
            </button>
            
            <div class="collapse mt-1" id="importCsvArea">
                <form asp-action="ImportFromCsv" method="post" enctype="multipart/form-data" class="card card-body p-2 border-primary">
                    <input type="file" name="csvFile" class="form-control form-control-sm mb-2" accept=".csv" required />
                    <button type="submit" class="btn btn-sm btn-success w-100 rounded-pill fw-bold">Upload & Import</button>
                </form>
            </div>

            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-sm btn-outline-secondary rounded-pill fw-bold">
                <i class="bi bi-speedometer2 me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Right Content: Table List -->
    <div class="col-lg-9 col-md-8">
        <!-- Stepped Hierarchy Overview -->
        @if (Model != null && Model.Any())
        {
            <div class="card mb-4 border-0 shadow-sm rounded-4" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); color: white;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-2"><i class="bi bi-diagram-3-fill me-2"></i>Hierarchy Tree Overview</h5>
                    <p class="small opacity-75 mb-3">Designations are structured hierarchically (one node can have multiple children). Employees can report to any manager with a higher designation level (closer to the root Admin).</p>
                    <div class="mt-3">
                        @{
                            void RenderTree(Designation parentNode, List<Designation> allItems)
                            {
                                var children = allItems.Where(d => d.ParentDesignationId == parentNode.Id).OrderBy(d => d.Name).ToList();
                                <li class="my-2">
                                    <div class="d-inline-flex align-items-center bg-white text-dark px-3 py-2 rounded-3 fw-bold shadow-sm" style="font-size: 0.85rem; border: 1px solid rgba(0,0,0,0.1);">
                                        <span class="badge bg-primary me-2">L@(parentNode.Level)</span> @parentNode.Name
                                    </div>
                                    @if (children.Any())
                                    {
                                        <ul class="list-unstyled ps-4 ms-2 my-1 border-start border-white-25 border-2">
                                            @foreach (var child in children)
                                            {
                                                RenderTree(child, allItems);
                                            }
                                        </ul>
                                    }
                                </li>
                            }

                            var root = Model.FirstOrDefault(d => d.ParentDesignationId == null);
                            if (root != null)
                            {
                                <ul class="list-unstyled mb-0">
                                    @{ RenderTree(root, Model.ToList()); }
                                </ul>
                            }
                            else if (Model.Any())
                            {
                                var lowestLevel = Model.Min(d => d.Level);
                                var rootNodes = Model.Where(d => d.Level == lowestLevel).ToList();
                                <ul class="list-unstyled mb-0">
                                    @foreach (var r in rootNodes)
                                    {
                                        RenderTree(r, Model.ToList());
                                    }
                                </ul>
                            }
                        }
                    </div>
                </div>
            </div>
        }

        <div class="main-content-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-list-nested"></i> Designation Hierarchy Levels</span>
        </div>
        <div class="main-content-body shadow-sm p-0">
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success border-0 rounded-0 m-0 py-3 px-4 small alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @Html.Raw(TempData["SuccessMessage"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger border-0 rounded-0 m-0 py-3 px-4 small alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @Html.Raw(TempData["ErrorMessage"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4 py-3 text-uppercase text-muted small">Designation Name</th>
                                    <th class="py-3 text-uppercase text-muted small">Reports To (Parent)</th>
                                    <th class="py-3 text-uppercase text-muted small text-center">Hierarchy Level</th>
                                    <th class="pe-4 py-3 text-uppercase text-muted small text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model)
                                {
                                    <tr>
                                        <td class="ps-4 py-3 fw-bold text-dark">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2 me-3">
                                                    <i class="bi bi-briefcase fs-5"></i>
                                                </div>
                                                <div>
                                                    <div style="font-size: 0.95rem;">@d.Name</div>
                                                    @if (d.ParentDesignationId == null)
                                                    {
                                                        <span class="badge bg-danger bg-opacity-10 text-danger" style="font-size: 0.65rem;">System Root</span>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-3 text-muted">
                                            @if (d.ParentDesignation != null)
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary" style="font-size: 0.8rem; padding: 6px 12px; border-radius: 6px;">
                                                    <i class="bi bi-arrow-up-circle-fill me-1 text-secondary"></i> @d.ParentDesignation.Name
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small"><em>None (System Root)</em></span>
                                            }
                                        </td>
                                        <td class="py-3 text-center fw-bold text-muted">
                                            @d.Level
                                        </td>
                                        <td class="pe-4 py-3 text-end">
                                            <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary px-3 rounded-pill fw-bold">
                                                <i class="bi bi-pencil-square me-1"></i>Edit
                                            </a>
                                        </td>
                                    </tr>
                                }
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">
                                            No designations configured in the system.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Designation Modal -->
<div class="modal fade" id="createDesignationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="Create" method="post" class="modal-content border-0 shadow rounded-4 overflow-hidden">
            @Html.AntiForgeryToken()
            <div class="modal-header bg-success text-white py-3 border-0">
                <h5 class="modal-title fs-5 fw-bold"><i class="bi bi-plus-circle me-2"></i>Add Custom Designation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-bold small text-muted text-uppercase">Designation Name</label>
                    <input type="text" name="Name" class="form-control" placeholder="e.g. Lead Developer" required maxlength="100" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold small text-muted text-uppercase">Parent Designation</label>
                    <select name="ParentDesignationId" class="form-select" required>
                        <option value="0">None (System Root)</option>
                        @if (ViewBag.ParentDesignations != null)
                        {
                            foreach (var p in (IEnumerable<HRMSystem.Models.Designation>)ViewBag.ParentDesignations)
                            {
                                <option value="@p.Id">@p.Name (Level @p.Level)</option>
                            }
                        }
                    </select>
                    <div class="form-text small text-info mt-1">
                        <i class="bi bi-info-circle me-1"></i> The level will be calculated automatically as <strong>Parent Level + 1</strong>. Employees can only report to higher levels.
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-0 py-3">
                <button type="button" class="btn btn-outline-secondary px-4 rounded-pill fw-bold" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-success px-4 rounded-pill fw-bold shadow-sm">
                    <i class="bi bi-check-circle-fill me-1"></i>Create Designation
                </button>
            </div>
        </form>
    </div>
</div>
