@using HRMSystem.Models
@model IEnumerable<HRMSystem.Models.LeaveRequest>
@{
    ViewData["Title"] = "My Leaves";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold m-0">My Leave Requests</h2>
    <a asp-action="Apply" class="btn btn-primary rounded-pill shadow-sm fw-bold px-4">
        <i class="bi bi-plus-lg me-1"></i> Apply for Leave
    </a>
</div>

<div class="card shadow border-0 rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Application Date</th>
                        <th>Leave Type</th>
                        <th>Duration Period</th>
                        <th>Total Days</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">@item.AppliedAt.ToShortDateString()</td>
                            <td class="fw-bold"><i class="bi bi-envelope text-primary me-2"></i>@item.LeaveType</td>
                            <td>@item.DisplayDates</td>
                            <td><span class="badge bg-secondary rounded-pill">@item.TotalDays days</span></td>
                            <td>
                                @if (item.Status == LeaveStatus.Pending) { <span class="badge bg-warning text-dark px-3 rounded-pill"><i class="bi bi-clock me-1"></i>Pending</span> }
                                else if (item.Status == LeaveStatus.Approved) { <span class="badge bg-success px-3 rounded-pill"><i class="bi bi-check-circle me-1"></i>Approved</span> }
                                else
                                {
                                    <span class="badge bg-danger px-3 rounded-pill mb-1"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                                    @if (!string.IsNullOrEmpty(item.RejectionRemark))
                                    {
                                        <i class="bi bi-info-circle ms-1 text-danger" title="@item.RejectionRemark" style="cursor:pointer;"
                                           data-bs-toggle="tooltip" data-bs-placement="top"></i>
                                    }
                                }
                            </td>
                        </tr>
                    }
                    @if(!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center py-5 text-muted">You haven't applied for any leaves yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Enable Bootstrap tooltips
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));
    </script>
}
