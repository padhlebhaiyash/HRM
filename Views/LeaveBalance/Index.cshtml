@model IEnumerable<HRMSystem.Models.Employee>
@{
    Layout = "_EmployeeDashboardLayout";
    ViewData["Title"] = "Leave Balances";
    ViewData["ActivePage"] = "Admin";
    var allTypes = (ViewBag.LeaveTypes as IEnumerable<HRMSystem.Models.LeaveType> ?? new List<HRMSystem.Models.LeaveType>()).ToList();
}

<div class="row">
    <!-- Left Sidebar -->
    <div class="col-lg-3 col-md-4 mb-4">
        <div class="bg-white text-center pb-3 shadow-sm border" style="padding: 15px;">
            <div class="profile-img-container mb-3">
                <i class="bi bi-wallet2-fill display-1 text-primary opacity-25"></i>
            </div>
            <h3 class="profile-name">Leave Balances</h3>
            <div class="profile-role">
                Admin Control
            </div>
            <div class="status-box">
                Allocation & Audit
            </div>
        </div>

        <div class="d-grid gap-2 mt-4">
            <a asp-controller="Admin" asp-action="TotalLeaves" class="btn btn-sm btn-info text-white rounded-pill fw-bold">
                <i class="bi bi-grid-3x3-gap-fill me-1"></i> Total Leaves Overview
            </a>
            <a asp-action="DownloadTemplate" class="btn btn-sm btn-success rounded-pill fw-bold">
                <i class="bi bi-file-earmark-arrow-down me-1"></i> Download Template
            </a>
            <button type="button" class="btn btn-sm btn-primary rounded-pill fw-bold" data-bs-toggle="modal" data-bs-target="#importModal">
                <i class="bi bi-upload me-1"></i> Import CSV
            </button>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-sm btn-outline-secondary rounded-pill fw-bold">
                <i class="bi bi-speedometer2 me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Right Content -->
    <div class="col-lg-9 col-md-8">
        <div class="main-content-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-wallet2"></i> Employee Leave Balances</span>
        </div>
        <div class="main-content-body shadow-sm p-0">


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow border-0 rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase text-muted small">Employee</th>
                        @foreach (var t in allTypes)
                        {
                            <th class="py-3 text-uppercase text-muted small text-center" title="Used / Allocated | Remaining">@t.Name</th>
                        }
                        <th class="pe-4 py-3 text-uppercase text-muted small text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3 fw-bold text-dark">
                                <div class="d-flex align-items-center">
                                    @if (string.IsNullOrEmpty(emp.PhotoPath))
                                    {
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-2 fw-bold" style="width:32px;height:32px;font-size:0.7rem;">
                                            @emp.FirstName[0]@emp.LastName[0]
                                        </div>
                                    }
                                    else
                                    {
                                        <img src="@emp.PhotoPath" class="rounded-circle me-2" style="width:32px;height:32px;object-fit:cover;" />
                                    }
                                    <div>
                                        <div style="white-space:nowrap;">@emp.FullName</div>
                                        <small class="text-muted">@emp.EmployeeCode</small>
                                    </div>
                                </div>
                            </td>
                            @foreach (var t in allTypes)
                            {
                                var bal = emp.LeaveBalances?.FirstOrDefault(b => b.LeaveTypeId == t.Id);
                                var allocated = bal?.Allocated ?? 0;
                                var used = bal?.Used ?? 0;
                                var remaining = bal?.Balance ?? 0;
                                var badgeColor = remaining < 0 ? "danger" : (remaining == 0 && used > 0 ? "secondary" : "info");

                                <td class="py-3 text-center">
                                    <span class="badge px-2 py-1 bg-@badgeColor bg-opacity-90" title="Used / Allocated | Remaining">
                                        @used.ToString("0.##") / @allocated.ToString("0.##")
                                        <span class="ms-1 border-start border-white border-opacity-50 ps-1 fw-bold">@remaining.ToString("0.##")</span>
                                    </span>
                                </td>
                            }
                            <td class="pe-4 py-3 text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary px-3"
                                        data-bs-toggle="modal" data-bs-target="#editBalanceModal"
                                        data-empid="@emp.Id" 
                                        data-empname="@emp.FullName"
                                        data-balances='@Json.Serialize(allTypes.ToDictionary(
                                            t => t.Code,
                                            t => {
                                                var bal = emp.LeaveBalances?.FirstOrDefault(b => b.LeaveTypeId == t.Id);
                                                return new { allocated = bal?.Allocated ?? 0, used = bal?.Used ?? 0 };
                                            }
                                        ))'>
                                    <i class="bi bi-pencil-square me-1"></i>Allocate
                                </button>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="@(allTypes.Count + 2)" class="text-center py-4 text-muted">No active employees found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
</div>

<!-- Import Modal -->
<div class="modal fade" id="importModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="Import" method="post" enctype="multipart/form-data" class="modal-content border-0 shadow rounded-4">
            @Html.AntiForgeryToken()
            <div class="modal-header bg-success text-white rounded-top-4 py-3">
                <h5 class="modal-title fs-6 fw-bold"><i class="bi bi-upload me-2"></i>Import Leave Allocations</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-info border-0 rounded-3 py-2 mb-3 small">
                    <i class="bi bi-lightbulb-fill me-2 text-warning"></i>
                    <strong>Quickest way:</strong> Click <em>Download Template</em> first — it downloads a pre-filled file with all current allocations. Edit the numbers and re-upload.
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Select CSV File</label>
                    <input type="file" name="csvFile" accept=".csv" class="form-control" required id="csvFileInput" />
                    <div class="form-text">Only <code>.csv</code> files accepted. Max size: 5 MB.</div>
                </div>

                <div class="card border-0 rounded-3 overflow-hidden" style="background:#f8f9fa;">
                    <div class="px-3 pt-3 pb-1">
                        <div class="fw-bold text-muted text-uppercase mb-2" style="font-size:0.7rem;letter-spacing:0.08em;">
                            <i class="bi bi-table me-1"></i>Expected File Structure
                        </div>
                    </div>
                    <div class="table-responsive px-3 pb-3">
                        <table class="table table-sm table-bordered mb-0" style="font-size:0.78rem;">
                            <thead class="table-dark">
                                <tr>
                                    <th>EmployeeCode</th>
                                    <th>EmployeeName</th>
                                    <th>Casual</th>
                                    <th>Sick</th>
                                    <th>Earned</th>
                                    <th>Unpaid</th>
                                    <th>WFH</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="table-success">
                                    <td>EMP001</td><td>John Doe</td>
                                    <td>12</td><td>10</td><td>25</td><td>0</td><td>6</td>
                                </tr>
                                <tr class="table-success">
                                    <td>EMP002</td><td>Jane Smith</td>
                                    <td>6</td><td>6</td><td>20</td><td>0</td><td>0</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <ul class="list-unstyled px-3 pb-3 small text-muted mb-0">
                        <li><i class="bi bi-check2 text-success me-1"></i>One row per employee &mdash; leave types are columns</li>
                        <li><i class="bi bi-check2 text-success me-1"></i><strong>EmployeeCode</strong> must match exactly (e.g. <code>EMP001</code>)</li>
                        <li><i class="bi bi-check2 text-success me-1"></i>Column order doesn't matter &mdash; header names are used to map values</li>
                        <li><i class="bi bi-check2 text-success me-1"></i>You can add or remove leave type columns as needed</li>
                        <li><i class="bi bi-info-circle text-primary me-1"></i><strong>EmployeeName</strong> column is informational only and is ignored during import</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer bg-light rounded-bottom-4">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-success px-4 fw-bold" id="importSubmitBtn">
                    <i class="bi bi-cloud-upload me-1"></i>Upload &amp; Import
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Balance Modal -->
<div class="modal fade" id="editBalanceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <form asp-action="Allocate" method="post" class="modal-content border-0 shadow rounded-4 overflow-hidden">
            @Html.AntiForgeryToken()
            <div class="modal-header bg-primary text-white py-3 border-0">
                <h5 class="modal-title fs-5 fw-bold"><i class="bi bi-gear-fill me-2"></i>Manage Leave Allocations</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light bg-opacity-50">
                <input type="hidden" name="employeeId" id="modalEmpId" />
                
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-body p-3 d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3">
                            <i class="bi bi-person-fill fs-4"></i>
                        </div>
                        <div>
                            <div class="text-uppercase text-muted fw-bold small" style="font-size: 0.75rem; letter-spacing: 0.05em;">Employee</div>
                            <h5 class="mb-0 fw-bold text-dark" id="modalEmpNameDisplay">Employee Name</h5>
                        </div>
                    </div>
                </div>

                <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-sliders me-1"></i>Yearly Allocations (Days)</h6>
                <div class="row g-3">
                    @foreach (var t in allTypes)
                    {
                        var leaveTypeStr = t.Code;
                        var iconClass = t.Code switch {
                            "Casual" => "bi-calendar-event",
                            "Sick" => "bi-heart-pulse",
                            "Earned" => "bi-award",
                            "Unpaid" => "bi-x-circle",
                            "WFH" => "bi-house-laptop",
                            _ => "bi-calendar-check"
                        };
                        var colorClass = t.Code switch {
                            "Casual" => "success",
                            "Sick" => "danger",
                            "Earned" => "primary",
                            "Unpaid" => "warning",
                            "WFH" => "info",
                            _ => "secondary"
                        };
                        
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm rounded-3 h-100 hover-shadow transition-all duration-200" style="border-left: 4px solid var(--bs-@colorClass) !important;">
                                <div class="card-body p-3 d-flex flex-column justify-content-between">
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <div class="d-flex align-items-center">
                                            <span class="badge bg-@colorClass bg-opacity-10 text-@colorClass p-2 me-2 rounded-3">
                                                <i class="bi @iconClass fs-5"></i>
                                            </span>
                                            <div>
                                                <h6 class="mb-0 fw-bold text-dark">@t.Name</h6>
                                                <small class="text-muted" id="used-info-@leaveTypeStr">Used: 0 days</small>
                                            </div>
                                        </div>
                                        <div style="width: 120px;">
                                            <div class="input-group input-group-sm border rounded-pill overflow-hidden bg-white shadow-sm">
                                                <button type="button" class="btn btn-light border-0 px-2 btn-decrement" data-type="@leaveTypeStr">
                                                    <i class="bi bi-dash fw-bold"></i>
                                                </button>
                                                <input type="number" step="0.5" min="0" 
                                                       name="allocations[@leaveTypeStr]" 
                                                       id="alloc-input-@leaveTypeStr" 
                                                       class="form-control border-0 text-center fw-bold alloc-input bg-transparent" 
                                                       style="box-shadow: none;"
                                                       placeholder="0" required 
                                                       data-type="@leaveTypeStr" />
                                                <button type="button" class="btn btn-light border-0 px-2 btn-increment" data-type="@leaveTypeStr">
                                                    <i class="bi bi-plus fw-bold"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="progress rounded-pill bg-light" style="height: 6px;">
                                            <div class="progress-bar bg-@colorClass rounded-pill progress-bar-striped progress-bar-animated" 
                                                 role="progressbar" 
                                                 id="progress-@leaveTypeStr" 
                                                 style="width: 0%;" 
                                                 aria-valuenow="0" 
                                                 aria-valuemin="0" 
                                                 aria-valuemax="100"></div>
                                        </div>
                                        <div class="d-flex justify-content-between mt-2" style="font-size: 0.72rem;">
                                            <span class="text-muted fw-semibold" id="remaining-info-@leaveTypeStr">Remaining: 0 days</span>
                                            <span class="text-muted fw-bold" id="percent-info-@leaveTypeStr">0% Used</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer bg-light border-0 py-3">
                <button type="button" class="btn btn-outline-secondary px-4 rounded-pill fw-bold" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary px-4 rounded-pill fw-bold shadow-sm">
                    <i class="bi bi-check-circle-fill me-1"></i>Save All Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Store current employee's leave usage so we can refer to it when inputs change
        var currentEmployeeBalances = {};

        document.getElementById('editBalanceModal').addEventListener('show.bs.modal', function (event) {
            var btn = event.relatedTarget;
            var empId = btn.getAttribute('data-empid');
            var empName = btn.getAttribute('data-empname');
            var balancesJson = btn.getAttribute('data-balances');
            
            this.querySelector('#modalEmpId').value = empId;
            var nameDisplayEl = this.querySelector('#modalEmpNameDisplay');
            if (nameDisplayEl) nameDisplayEl.textContent = empName;
            
            try {
                currentEmployeeBalances = JSON.parse(balancesJson || '{}');
            } catch (e) {
                console.error("Error parsing employee balances", e);
                currentEmployeeBalances = {};
            }

            // Populate all inputs and update progress bars
            for (var leaveType in currentEmployeeBalances) {
                var data = currentEmployeeBalances[leaveType];
                var input = document.getElementById('alloc-input-' + leaveType);
                if (input) {
                    input.value = data.allocated;
                    // Trigger update manually
                    updateLeaveVisuals(leaveType, data.allocated, data.used);
                }
            }
        });

        function updateLeaveVisuals(leaveType, allocated, used) {
            allocated = parseFloat(allocated) || 0;
            used = parseFloat(used) || 0;
            var remaining = allocated - used;
            
            var percent = 0;
            if (allocated > 0) {
                percent = Math.round((used / allocated) * 100);
            } else if (used > 0) {
                percent = 100;
            }

            // Elements
            var usedInfo = document.getElementById('used-info-' + leaveType);
            var remainingInfo = document.getElementById('remaining-info-' + leaveType);
            var percentInfo = document.getElementById('percent-info-' + leaveType);
            var progressBar = document.getElementById('progress-' + leaveType);

            if (usedInfo) usedInfo.textContent = 'Used: ' + used.toFixed(1).replace('.0', '') + ' days';
            
            if (remainingInfo) {
                remainingInfo.textContent = 'Remaining: ' + remaining.toFixed(1).replace('.0', '') + ' days';
                if (remaining < 0) {
                    remainingInfo.className = 'text-danger fw-bold';
                } else {
                    remainingInfo.className = 'text-muted fw-semibold';
                }
            }

            if (percentInfo) {
                percentInfo.textContent = percent + '% Used';
                if (percent > 100) {
                    percentInfo.className = 'text-danger fw-bold';
                } else {
                    percentInfo.className = 'text-muted fw-bold';
                }
            }

            if (progressBar) {
                // Limit width to 100%
                var barPercent = Math.min(100, Math.max(0, percent));
                progressBar.style.width = barPercent + '%';
                
                // Color coding based on usage limit
                progressBar.classList.remove('bg-danger', 'bg-warning', 'bg-success', 'bg-primary', 'bg-info');
                
                // Determine original color class from leave type mapping
                var defaultColor = 'primary';
                if (leaveType === 'Casual') defaultColor = 'success';
                else if (leaveType === 'Sick') defaultColor = 'danger';
                else if (leaveType === 'Earned') defaultColor = 'primary';
                else if (leaveType === 'Unpaid') defaultColor = 'warning';
                else if (leaveType === 'WFH') defaultColor = 'info';

                if (percent > 100) {
                    progressBar.classList.add('bg-danger');
                } else if (percent > 85) {
                    progressBar.classList.add('bg-warning');
                } else {
                    progressBar.classList.add('bg-' + defaultColor);
                }
            }
        }

        // Live input updates
        document.querySelectorAll('.alloc-input').forEach(function (input) {
            input.addEventListener('input', function () {
                var type = this.getAttribute('data-type');
                var allocated = parseFloat(this.value) || 0;
                var used = currentEmployeeBalances[type] ? currentEmployeeBalances[type].used : 0;
                updateLeaveVisuals(type, allocated, used);
            });
        });

        // Increment & Decrement buttons
        document.querySelectorAll('.btn-increment').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var type = this.getAttribute('data-type');
                var input = document.getElementById('alloc-input-' + type);
                if (input) {
                    var val = parseFloat(input.value) || 0;
                    input.value = val + 0.5;
                    // Trigger input event
                    input.dispatchEvent(new Event('input'));
                }
            });
        });

        document.querySelectorAll('.btn-decrement').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var type = this.getAttribute('data-type');
                var input = document.getElementById('alloc-input-' + type);
                if (input) {
                    var val = parseFloat(input.value) || 0;
                    if (val > 0) {
                        input.value = Math.max(0, val - 0.5);
                        // Trigger input event
                        input.dispatchEvent(new Event('input'));
                    }
                }
            });
        });

        // Import — show spinner on submit and validate file size
        document.getElementById('importModal')?.querySelector('form')?.addEventListener('submit', function (e) {
            var fileInput = document.getElementById('csvFileInput');
            if (fileInput.files.length === 0) return;
            var file = fileInput.files[0];
            if (file.size > 5 * 1024 * 1024) {
                e.preventDefault();
                alert('File is too large. Maximum size is 5 MB.');
                return;
            }
            var btn = document.getElementById('importSubmitBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Importing…';
        });
    </script>
}
