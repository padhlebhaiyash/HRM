@using HRMSystem.Models
@{
    Layout = "_EmployeeDashboardLayout";
    ViewData["Title"] = "Manager Dashboard";
    ViewData["ActivePage"] = "ManagerHome";

    var manager = ViewBag.Manager as Employee;
    var subordinates = ViewBag.Subordinates as List<Employee> ?? new List<Employee>();
    var pendingLeaves = ViewBag.PendingLeaves as List<LeaveRequest> ?? new List<LeaveRequest>();
    var recentLeaves = ViewBag.RecentLeaves as List<LeaveRequest> ?? new List<LeaveRequest>();
    var teamBalances = ViewBag.TeamBalances as List<LeaveBalance> ?? new List<LeaveBalance>();
    int teamSize = ViewBag.TeamSize ?? 0;

    // On leave today count
    var today = DateTime.Today;
    var onLeaveToday = recentLeaves.Count(l => l.Status == LeaveStatus.Approved && l.StartDate <= today && l.EndDate >= today);
}

<div class="row">
    <!-- Left Sidebar: Manager Profile & Team Stats -->
    <div class="col-lg-3 col-md-4 mb-4">
        <!-- Profile Box -->
        <div class="bg-white text-center pb-3 shadow-sm border" style="padding: 15px;">
            <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(manager?.FullName ?? "Manager")&size=250&background=random" 
                 alt="Profile Photo" class="profile-img mb-3" />
            <h3 class="profile-name">@manager?.FullName</h3>
            <div class="profile-role">
                Manager &mdash; @manager?.Department?.Name
            </div>
            <div class="status-box">
                Team Size: @teamSize
            </div>
        </div>

        <!-- Team Quick Stats -->
        <div class="section-header mt-4">
            <i class="bi bi-graph-up"></i> Team Snapshot
        </div>
        
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small">Pending Approvals</span>
                    <span class="badge bg-warning text-dark rounded-pill">@pendingLeaves.Count</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small">On Leave Today</span>
                    <span class="badge bg-danger rounded-pill">@onLeaveToday</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small">Available Today</span>
                    <span class="badge bg-success rounded-pill">@(teamSize - onLeaveToday)</span>
                </div>
            </div>
        </div>

        <div class="d-grid gap-2">
            <a asp-action="TeamLeaves" class="btn btn-sm btn-outline-primary rounded-pill fw-bold">
                <i class="bi bi-clock-history me-1"></i> Team History
            </a>
            <a asp-controller="EmployeeSelf" asp-action="TeamCalendar" class="btn btn-sm btn-outline-secondary rounded-pill fw-bold">
                <i class="bi bi-calendar-event me-1"></i> Team Calendar
            </a>
        </div>
    </div>

    <!-- Right Content: Pending Approvals & Team Activity -->
    <div class="col-lg-9 col-md-8">
        <!-- Pending Approvals -->
        <div class="main-content-header">
            <i class="bi bi-hourglass-split"></i> Pending Leave Requests
        </div>
        <div class="main-content-body shadow-sm p-0 mb-4">
            @if (pendingLeaves.Any())
            {
                <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Employee</th>
                            <th>Type</th>
                            <th>Dates</th>
                            <th>Days</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var leave in pendingLeaves)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@leave.Employee?.FullName</td>
                                <td><span class="badge bg-light text-dark border">@leave.LeaveType?.Name</span></td>
                                <td class="small">@leave.DisplayDates</td>
                                <td>@leave.TotalDays</td>
                                <td class="text-end pe-3">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <form asp-controller="Leave" asp-action="Approve" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@leave.Id" />
                                            <input type="hidden" name="redirectTo" value="Dashboard" />
                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-3"
                                                    onclick="return confirm('Approve leave for @leave.Employee?.FullName?')">
                                                Approve
                                            </button>
                                        </form>
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                onclick="openRejectModal(@leave.Id, '@Html.Raw(leave.Employee?.FullName?.Replace("'", "\\'"))', 'Dashboard')">
                                            Reject
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-check-circle fs-1 text-success opacity-25"></i>
                    <p class="mt-2 mb-0">No pending leave requests from your team.</p>
                </div>
            }
        </div>

        <!-- Team Members List -->
        <div class="main-content-header bg-secondary">
            <i class="bi bi-people"></i> My Team Members
        </div>
        <div class="main-content-body shadow-sm p-0 mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Member</th>
                            <th>Designation</th>
                            <th>Status Today</th>
                            <th class="text-end pe-3">Leave Balance (EL/SL/CL)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in subordinates)
                        {
                            var empOnLeave = recentLeaves.Any(l => l.EmployeeId == emp.Id && l.Status == LeaveStatus.Approved && l.StartDate <= today && l.EndDate >= today);
                            var empBalances = teamBalances.Where(b => b.EmployeeId == emp.Id).ToList();
                            
                            <tr>
                                <td class="ps-3 fw-bold">@emp.FullName</td>
                                <td class="text-muted">@emp.Designation?.Name</td>
                                <td>
                                    @if (empOnLeave)
                                    { <span class="badge bg-danger rounded-pill px-3">On Leave</span> }
                                    else
                                    { <span class="badge bg-success rounded-pill px-3">Active</span> }
                                </td>
                                <td class="text-end pe-3 text-muted">
                                    @{
                                         var el = empBalances.FirstOrDefault(b => b.LeaveType?.Code == "Earned")?.Balance ?? 0;
                                         var sl = empBalances.FirstOrDefault(b => b.LeaveType?.Code == "Sick")?.Balance ?? 0;
                                         var cl = empBalances.FirstOrDefault(b => b.LeaveType?.Code == "Casual")?.Balance ?? 0;
                                    }
                                    @el / @sl / @cl
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_RejectModal")

@section Scripts {
    <script>
        // Enable Bootstrap tooltips if any
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));
    </script>
}
