@using HRMSystem.Models
@model IEnumerable<HRMSystem.Models.PayrollRecord>
@{
    ViewData["Title"] = "Payroll Administration";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold m-0">Payroll Administration</h2>
    <a asp-action="Generate" class="btn btn-primary rounded-pill shadow-sm fw-bold px-4">
        <i class="bi bi-file-earmark-plus me-1"></i> Generate Payroll
    </a>
</div>

<div class="card shadow border-0 rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Employee</th>
                        <th>Month/Year</th>
                        <th>Basic Salary</th>
                        <th>Net Salary</th>
                        <th>Status</th>
                        <th class="pe-4 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@item.Employee?.FullName</td>
                            <td>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(item.Month) @item.Year</td>
                            <td class="text-muted">@item.BasicSalary.ToString("C")</td>
                            <td class="text-success fw-bold">@item.NetSalary.ToString("C")</td>
                            <td>
                                @if(item.Status == PayrollStatus.Draft) { <span class="badge bg-secondary rounded-pill">Draft</span> }
                                else if(item.Status == PayrollStatus.Processed) { <span class="badge bg-warning text-dark rounded-pill shadow-sm">Processed</span> }
                                else { <span class="badge bg-success rounded-pill shadow-sm"><i class="bi bi-check2-all me-1"></i>Paid</span> }
                            </td>
                            <td class="pe-4 text-end">
                                <a asp-action="PaySlip" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-pill" title="View Payslip">
                                    <i class="bi bi-file-earmark-text"></i>
                                </a>
                                @if (item.Status == PayrollStatus.Processed)
                                {
                                    <form asp-action="MarkPaid" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-success rounded-pill ms-1" onclick="return confirm('Mark this payroll as paid?');" title="Mark Paid">
                                            <i class="bi bi-cash-stack"></i> Pay
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if(!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted">No payroll records found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
