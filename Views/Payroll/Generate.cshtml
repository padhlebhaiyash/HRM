@model HRMSystem.Models.PayrollRecord
@{
    Layout = "_EmployeeDashboardLayout";
    ViewData["Title"] = "Generate Payroll";
    ViewData["ActivePage"] = "Admin";
}

<div class="row">
    <!-- Left Sidebar -->
    <div class="col-lg-3 col-md-4 mb-4">
        <div class="bg-white text-center pb-3 shadow-sm border" style="padding: 15px;">
            <div class="profile-img-container mb-3">
                <i class="bi bi-cash-stack display-1 text-success opacity-25"></i>
            </div>
            <h3 class="profile-name">Payroll Processing</h3>
            <div class="profile-role">
                Admin Control
            </div>
            <div class="status-box">
                Finance Desk
            </div>
        </div>

        <div class="d-grid gap-2 mt-4">
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-sm btn-outline-secondary rounded-pill fw-bold">
                <i class="bi bi-speedometer2 me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Right Content -->
    <div class="col-lg-9 col-md-8">
        <div class="main-content-header">
            <i class="bi bi-calculator"></i> Generate Monthly Payroll
        </div>
        <div class="main-content-body shadow-sm">
            <form asp-action="Generate">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                <div class="row g-4 mb-4">
                    <div class="col-md-12">
                        <label asp-for="EmployeeId" class="form-label fw-bold small text-uppercase text-muted">Select Employee</label>
                        <select asp-for="EmployeeId" class="form-select" asp-items="ViewBag.Employees" required>
                            <option value="">-- Choose Employee --</option>
                        </select>
                        <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Month" class="form-label fw-bold small text-uppercase text-muted">Pay Month</label>
                        <select asp-for="Month" class="form-select" required>
                            @for (int i = 1; i <= 12; i++)
                            {
                                if (DateTime.Now.Month == i)
                                {
                                    <option value="@i" selected>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                                }
                                else
                                {
                                    <option value="@i">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Year" class="form-label fw-bold small text-uppercase text-muted">Pay Year</label>
                        <input asp-for="Year" class="form-control" type="number" value="@DateTime.Now.Year" required />
                    </div>
                </div>

                <div class="row g-4 mb-5 border-top pt-4">
                    <div class="col-md-4">
                        <label asp-for="BasicSalary" class="form-label fw-bold small text-uppercase text-muted">Basic Salary</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="BasicSalary" class="form-control" type="number" step="0.01" required />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Allowances" class="form-label fw-bold small text-uppercase text-muted">Allowances</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Allowances" class="form-control" type="number" step="0.01" value="0.00" />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Deductions" class="form-label fw-bold small text-uppercase text-muted text-danger">Deductions</label>
                        <div class="input-group">
                            <span class="input-group-text bg-danger bg-opacity-10 text-danger border-danger">$</span>
                            <input asp-for="Deductions" class="form-control border-danger" type="number" step="0.01" value="0.00" />
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success btn-lg rounded-pill fw-bold">
                        <i class="bi bi-check2-circle me-1"></i> Process & Finalize Payroll
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

