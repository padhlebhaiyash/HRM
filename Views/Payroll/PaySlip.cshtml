@model HRMSystem.Models.PayrollRecord
@{
    Layout = "_EmployeeDashboardLayout";
    ViewData["Title"] = "Pay Slip - " + System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Month) + " " + Model.Year;
}

<div class="main-content-header d-flex justify-content-between align-items-center d-print-none">
    <div><i class="bi bi-file-earmark-pdf me-2"></i> Monthly Payslip</div>
    <div>
        <button onclick="window.print()" class="btn btn-sm btn-light rounded-0 fw-bold text-uppercase" style="font-size: 0.75rem;">
            <i class="bi bi-printer me-1"></i> Print
        </button>
        <a asp-action="MyPayroll" class="btn btn-sm btn-outline-light rounded-0 fw-bold text-uppercase ms-2" style="font-size: 0.75rem;">Back</a>
    </div>
</div>

<div class="main-content-body shadow-sm p-4">
    <div class="payslip-container mx-auto p-4 border" style="max-width: 900px; background-color: #fff;">

        
        <div class="row border-bottom pb-4 mb-4">
            <div class="col-md-6">
                <h2 class="fw-bold text-primary mb-0"><i class="bi bi-building me-2"></i>HRM System</h2>
                <div class="text-muted small mt-2">123 Business Avenue, Suite 100<br/>City, ST 12345</div>
            </div>
            <div class="col-md-6 text-md-end mt-4 mt-md-0">
                <h4 class="fw-bold text-uppercase" style="letter-spacing: 2px;">Payslip</h4>
                <div class="fs-5 text-secondary">
                    @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.Month) @Model.Year
                </div>
            </div>
        </div>

        <div class="row bg-light rounded-3 p-4 mb-5 mx-0 g-4">
            <div class="col-sm-6">
                <div class="px-2">
                    <div class="small fw-bold text-uppercase text-muted mb-1">Employee Details</div>
                    <h5 class="fw-bold mb-1">@Model.Employee?.FullName</h5>
                    <div class="text-muted"><i class="bi bi-person-badge me-2"></i>@Model.Employee?.EmployeeCode</div>
                    <div class="text-muted"><i class="bi bi-briefcase me-2"></i>@Model.Employee?.Designation?.Name</div>
                    <div class="text-muted"><i class="bi bi-diagram-3 me-2"></i>@Model.Employee?.Department?.Name</div>
                </div>
            </div>
            <div class="col-sm-6 text-sm-end">
                <div class="px-2">
                    <div class="small fw-bold text-uppercase text-muted mb-1">Payment Details</div>
                    <div class="mb-1"><span class="text-muted me-2">Generated On:</span> @Model.GeneratedAt.ToShortDateString()</div>
                    <div class="mb-1">
                        <span class="text-muted me-2">Status:</span> 
                        <span class="fw-bold text-@(Model.Status == HRMSystem.Models.PayrollStatus.Paid ? "success" : "warning")">
                            @Model.Status.ToString().ToUpper()
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive mb-5">
            <table class="table table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 px-4 text-uppercase">Earnings</th>
                        <th class="py-3 px-4 text-end text-uppercase">Amount</th>
                        <th class="py-3 px-4 text-uppercase">Deductions</th>
                        <th class="py-3 px-4 text-end text-uppercase">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="py-3 px-4 fw-bold text-muted">Basic Salary</td>
                        <td class="py-3 px-4 text-end">@Model.BasicSalary.ToString("C")</td>
                        <td class="py-3 px-4 fw-bold text-muted">Taxes & Absences</td>
                        <td class="py-3 px-4 text-end text-danger">@Model.Deductions.ToString("C")</td>
                    </tr>
                    <tr>
                        <td class="py-3 px-4 fw-bold text-muted">Allowances (Bonus)</td>
                        <td class="py-3 px-4 text-end">@Model.Allowances.ToString("C")</td>
                        <td class="py-3 px-4"></td>
                        <td class="py-3 px-4 text-end"></td>
                    </tr>
                    <tr class="bg-light">
                        <td class="py-3 px-4 fw-bold">Total Earnings</td>
                        <td class="py-3 px-4 text-end fw-bold">@((Model.BasicSalary + Model.Allowances).ToString("C"))</td>
                        <td class="py-3 px-4 fw-bold">Total Deductions</td>
                        <td class="py-3 px-4 text-end fw-bold text-danger">@Model.Deductions.ToString("C")</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="row border rounded-4 bg-primary text-white p-4 mx-0 shadow-sm align-items-center">
            <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                <div class="text-white-50 text-uppercase fw-bold mb-1" style="letter-spacing: 1px;">Net Pay</div>
                <div class="display-5 fw-bold">@Model.NetSalary.ToString("C")</div>
            </div>
            <div class="col-md-6 text-center text-md-end text-white-50 small">
                <i>Amount in words not available for auto-generation.</i>
            </div>
        </div>

        <div class="row mt-5 pt-5 text-center text-muted">
            <div class="col-6">
                <div class="border-top mx-auto pt-2" style="width: 200px;">Employer Signature</div>
            </div>
            <div class="col-6">
                <div class="border-top mx-auto pt-2" style="width: 200px;">Employee Signature</div>
            </div>
        </div>
    </div>
</div>
