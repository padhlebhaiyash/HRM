@* Shared Rejection Remark Modal — include with @await Html.PartialAsync("_RejectModal") *@
<div class="modal fade" id="rejectRemarkModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form id="rejectRemarkForm" method="post" class="modal-content border-0 shadow rounded-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="rejectLeaveId" name="id" />
            <input type="hidden" id="rejectRedirectTo" name="redirectTo" />

            <div class="modal-header bg-danger text-white rounded-top-4 py-3">
                <h5 class="modal-title fs-6 fw-bold">
                    <i class="bi bi-x-circle me-2"></i>Reject Leave Request
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <div class="small text-muted mb-3">Employee: <strong id="rejectEmployeeName"></strong></div>
                    <label for="rejectRemarkText" class="form-label fw-bold">
                        Rejection Remark <span class="text-danger">*</span>
                    </label>
                    <textarea id="rejectRemarkText" name="remark" class="form-control" rows="3"
                              maxlength="500" placeholder="Please provide a reason for rejection…" required></textarea>
                    <div class="form-text">This remark will be visible to the employee. Max 500 characters.</div>
                </div>
            </div>
            <div class="modal-footer bg-light rounded-bottom-4">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger px-4 fw-bold">
                    <i class="bi bi-x-circle me-1"></i>Reject
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openRejectModal(leaveId, employeeName, redirectTo) {
        document.getElementById('rejectLeaveId').value = leaveId;
        document.getElementById('rejectEmployeeName').textContent = employeeName;
        document.getElementById('rejectRedirectTo').value = redirectTo || '';
        document.getElementById('rejectRemarkText').value = '';
        // Set the form action dynamically
        document.getElementById('rejectRemarkForm').action = '/Leave/Reject';
        var modal = new bootstrap.Modal(document.getElementById('rejectRemarkModal'));
        modal.show();
    }
</script>
